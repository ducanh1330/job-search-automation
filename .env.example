# Copy to .env and fill in. Never commit .env.

# --- Scraping / web ---
# Firecrawl fetches pages from its own infrastructure, which is what makes this
# work at all -- Seek's Cloudflare protection blocks direct requests by IP.
# Get a key at https://firecrawl.dev -> Dashboard -> API Keys (starts with "fc-")
FIRECRAWL_API_KEY=
